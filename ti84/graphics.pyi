"""Screen drawing. This stub is the union of APIs from both backends.

Backend-only functions are annotated below. Pixel coordinates use (0, 0) at
the top left by default.
"""

from typing import Literal

BLACK: int
WHITE: int
RED: int
GREEN: int
BLUE: int
YELLOW: int
CYAN: int
MAGENTA: int
ORANGE: int
PINK: int
PURPLE: int
MINT: int
PEACH: int
PALE_YELLOW: int
PALE_PINK: int
PALE_MINT: int
GRAY: int

def begin() -> None: ...
def end() -> None: ...
def clear() -> None: ...
# Flash App backend only.
def set_color(color: int) -> int: ...
def fill_screen(color: int = ...) -> None: ...
def pixel(x: int, y: int, color: int = ...) -> None: ...
# Standalone assembly backend only; Flash App sprite support is not implemented.
def sprite(pixels: tuple[tuple[int | None, ...], ...], x: int, y: int) -> None: ...
# Flash App backend only.
def get_pixel(x: int, y: int) -> int: ...
def line(x1: int, y1: int, x2: int, y2: int, color: int = ...) -> None: ...
def rect(x: int, y: int, width: int, height: int, color: int = ...) -> None: ...
# Flash App backend only; use rect() on the assembly targets.
def rectangle(x: int, y: int, width: int, height: int, color: int = ...) -> None: ...
def fill_rect(x: int, y: int, width: int, height: int, color: int = ...) -> None: ...
# Flash App backend only.
def fill_rectangle(x: int, y: int, width: int, height: int, color: int = ...) -> None: ...
def triangle(x1: int, y1: int, x2: int, y2: int, x3: int, y3: int, color: int = ...) -> None: ...
def circle(x: int, y: int, radius: int, color: int = ...) -> None: ...
# Flash App backend only.
def fill_circle(x: int, y: int, radius: int, color: int = ...) -> None: ...
# Flash App backend only.
def horiz_line(x: int, y: int, length: int, color: int = ...) -> None: ...
def vert_line(x: int, y: int, length: int, color: int = ...) -> None: ...
def text(string: str, x: int, y: int, color: int = ..., *, origin: Literal["center", "top_left"] = ...) -> None: ...
# Flash App backend only.
def text_int(value: int, x: int, y: int, color: int = ...) -> None: ...
# Standalone assembly backend only; it is a simple cycle-count delay loop.
def delay(count: int) -> None: ...
def wait_key() -> None: ...
# Flash App backend only.
def save_cursor(x: int, y: int) -> None: ...
def restore_cursor() -> None: ...
# Available on both backends; values depend on the selected target.
width: int
height: int
