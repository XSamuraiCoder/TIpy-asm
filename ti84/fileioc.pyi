"""File I/O library type stubs for TIpy calculator programs.

These stubs describe the fileioc library API for editor completion and type
checking. They do not provide desktop Python runtime implementations.
"""

from typing import Literal, Any

# File modes
MODE_READ: str
MODE_WRITE: str
MODE_APPEND: str
MODE_READ_WRITE: str

# File types
TYPE_PROGRAM: int
TYPE_APPVAR: int

# File handle type (opaque)
FileHandle = Any

def open(name: str, mode: str = ...) -> FileHandle: ...
def close(handle: FileHandle) -> None: ...
def read(handle: FileHandle, size: int, buffer: Any | None = ...) -> bytes: ...
def write(handle: FileHandle, data: bytes) -> None: ...
def seek(handle: FileHandle, offset: int, whence: int = ...) -> None: ...
def tell(handle: FileHandle) -> int: ...
def size(name: str) -> int: ...
def exists(name: str) -> bool: ...
def delete(name: str) -> None: ...
def create(name: str, initial_data: bytes | None = ...) -> None: ...
def rename(old_name: str, new_name: str) -> None: ...
