"""Serial bytes: a USB serial port on the CE (TIpy's own driver), the link port on classic calculators."""

def begin(baud: int = 9600) -> int: ...
def end() -> None: ...
def connected() -> bool: ...
def read_byte() -> int: ...
def write_byte(value: int) -> bool: ...
def write(text: str) -> int: ...
def write_int(value: int) -> int: ...
