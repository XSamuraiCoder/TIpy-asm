"""Byte storage backed by named calculator AppVars.

exists(), size(), and delete() are assembly-only; ti84.file has them on both backends.
"""

def create(name: str, size: int) -> None: ...
def exists(name: str) -> bool: ...
def size(name: str) -> int: ...
def delete(name: str) -> None: ...
def read_byte(name: str, offset: int) -> int: ...
def write_byte(name: str, offset: int, value: int) -> None: ...
